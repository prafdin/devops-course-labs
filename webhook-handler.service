[Unit]
Description=GitHub Webhook Handler
After=network.target

[Service]
User=vboxuser
WorkingDirectory=/home/vboxuser/webhook-handler
ExecStart=/home/vboxuser/webhook-handler/.venv/bin/python3 /home/vboxuser/webhook-handler/webhook.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
