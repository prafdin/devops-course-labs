[Unit]
Description=Catty Reminders App
After=network.target

[Service]
User=yarik
WorkingDirectory=/home/yarik/Desktop/catty-reminders-app
EnvironmentFile=-/home/yarik/Desktop/catty-reminders-app/.env
ExecStart=/home/yarik/Desktop/catty-reminders-app/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8181
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
