# /etc/systemd/system/catty.service

[Unit]
Description=Catty Reminders App
After=network.target

[Service]
User=vboxuser
WorkingDirectory=/home/vboxuser/catty-reminders-app

EnvironmentFile=/etc/catty.env
Environment=PYTHONPATH=/home/vboxuser/catty-reminders-app

ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8181

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
