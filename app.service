[Unit]
Description=Catty Reminders App
After=network.target

[Service]
User=qzm
Group=qzm
WorkingDirectory=/home/qzm/Desktop/catty-reminders-app
EnvironmentFile=/home/qzm/Desktop/catty-reminders-app/.env
ExecStart=/home/qzm/Desktop/catty-reminders-app/.venv/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8181
Restart=always

[Install]
WantedBy=multi-user.target
